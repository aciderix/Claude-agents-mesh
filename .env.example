# ---------------------------------------------------------------------------
# Claude Agents Mesh — environment reference
# ---------------------------------------------------------------------------
# Nothing secret is committed. This file only documents what to set WHERE.

# 1) EDGE FUNCTION SECRETS (server side) — set in the Supabase dashboard under
#    Edge Functions → coordinator → Secrets, or with the CLI:
#      supabase secrets set --project-ref <ref> MESH_BOOTSTRAP_SECRET=$(openssl rand -hex 32)
#
#    SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically by
#    Supabase — do NOT set them yourself and never commit the service_role key.
MESH_BOOTSTRAP_SECRET=change-me-to-a-long-random-string

# 2) CLAUDE CODE SESSION (client side) — what each agent uses to connect.
#    Either enter these in the plugin's config prompt, or add the MCP server
#    manually in claude.ai/code settings with the URL + Authorization header.
MESH_MCP_URL=https://<project-ref>.supabase.co/functions/v1/coordinator/mcp
MESH_MCP_TOKEN=mesh_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 3) OPTIONAL statusline / hooks tuning
# MESH_AGENT_NAME=Claude-A      # display label for this session's agent
# MESH_WARN_AT=90               # statusline emits quota_warning at/above this %%
